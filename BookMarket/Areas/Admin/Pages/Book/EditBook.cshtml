@page
@using Services.Application
@model BookMarket.Areas.Admin.Pages.Book.EditBookModel
@{
}
<div class="row">
	<!-- BEGIN BREADCRUMB -->
	<div class="col-md-12">
		<div class="breadcrumb-box shadow">
			<ul class="breadcrumb">
				<li><a href="/Admin/Index">پیشخوان</a></li>
				<li><a href="/Admin/Book/AdminIndex">مدیریت کتاب ها</a></li>
				<li class="active">ویرایش کتاب</li>
			</ul>
			<div class="breadcrumb-left">
				@ConvertDateTime.ConvertMiladiToShamsi(DateTime.Now, "HH:mm  dd MMMM yyyy")

				<i class="icon-calendar"></i>
			</div><!-- /.breadcrumb-left -->
		</div><!-- /.breadcrumb-box -->
	</div><!-- /.col-md-12 -->
	<!-- END BREADCRUMB -->

	<div class="col-12">
		<div class="portlet box shadow">
			<div class="portlet-heading">
				<div class="portlet-title">
					<h3 class="title">
						<i class="icon-note"></i>
						ویرایش کتاب
					</h3>

				</div><!-- /.portlet-title -->

			</div><!-- /.portlet-heading -->

			<div class="portlet-body edit-form">

				<div class="row">
					<div class="col-lg-6 col-md-10 m-auto m-b-30">

						<form method="post" enctype="multipart/form-data">

							<input type="hidden" asp-for="@Model.Book.Picture" />

							<div class="form-body">
								<div class="form-group relative mt-3 mb-4">
									<input type="file" asp-for="@Model.Book.FileName" name="FileName" class="form-control">
									<div class="input-group round">
										<input type="text" name="Picture" asp-for="@Model.Book.Picture" class="form-control file-input" placeholder="برای آپلود کلیک کنید">
										<span class="input-group-btn">
											<button type="button" class="btn btn-success">
												<i class="icon-picture"></i>
												آپلود عکس
												<div class="paper-ripple"><div class="paper-ripple__background"></div><div class="paper-ripple__waves"></div></div>
											</button>
										</span>
									</div><!-- /.input-group -->
									<div class="help-block"></div>
								</div>
								<div class="col-sm-6">
									<div class="form-group">
										<label for="txt-firstname">عنوان کتاب</label>
										<div class="input-group round">
											<span class="input-group-addon">
												<i class="icon-user"></i>
											</span>
											<input type="text" name="BookTitle" asp-for="@Model.Book.BookTitle" class="form-control rtl text-right" placeholder="لطفا عنوان کتاب مقاله را وارد نمایید.">
										</div><!-- /.input-group -->
									</div><!-- /.form-group -->
								</div><!-- /.col -->
								<div class="col-sm-6">
									<div class="form-group">
										<label for="txt-firstname">نویسنده</label>
										<div class="input-group round">
											<span class="input-group-addon">
												<i class="icon-user"></i>
											</span>
											<input type="text" name="Writer" asp-for="@Model.Book.Writer" class="form-control rtl text-right" placeholder="لطفا عنوان کتاب مقاله را وارد نمایید.">
										</div><!-- /.input-group -->
									</div><!-- /.form-group -->
								</div><!-- /.col -->
								<div class="col-sm-6">
									<div class="form-group">
										<label for="txt-firstname">انتشارات</label>
										<div class="input-group round">
											<span class="input-group-addon">
												<i class="icon-user"></i>
											</span>
											<input type="text" name="Publisher" asp-for="@Model.Book.Publisher" class="form-control rtl text-right" placeholder="لطفا عنوان کتاب مقاله را وارد نمایید.">
										</div><!-- /.input-group -->
									</div><!-- /.form-group -->
								</div><!-- /.col -->
								<div class="form-group col-6">
									<label for="txt-mobile">توضیحات کوتاه</label>
									<div class="input-group round">
										<span class="input-group-addon col-6 cols-xs-12 ">
											<i class="icon-envelope"></i>
										</span>
										<textarea type="text"  asp-for="@Model.Book.shortdescription" name="ShortDescription" class="form-control rtl text-right " placeholder="مقدار توضیحات کوتاه باید یا شامل مقدمه یا شامل یک بند خلاصه مقاله شما باشد."></textarea>
									</div><!-- /.input-group -->
								</div><!-- /.form-group -->
								<div class="form-group col-6 cols-xs-12">
									<label>دسته بندی</label>
									<div class="col-md-12">
										<div class="form-group">
											<label asp-for="@Model.Book.CategoryId" class="control-label">دسته بندی</label>

											<select type="text" class="form-control" name="CategoryId" asp-for="@Model.Book.CategoryId" asp-items='new SelectList(@Model.Book.BookCategories, "Id", "CategoryName")'>

												<option value="0">انتخاب دسته بندی ....</option>
											</select>
											<span asp-validation-for="@Model.Book.CategoryId" class="error"></span>
										</div>
									</div>
									<label>قیمت</label>
									<div class="input-group round col-3 cols-xs-12">
										<span class="input-group-addon">
											<i class="icon-envelope"></i>
										</span>
										<input type="number" name="Price" asp-for="@Model.Book.Price" class="form-control rtl text-Right" placeholder="قیمت کتاب"></input>
									</div><!-- /.input-group -->
									</div><!-- /.form-group -->
								</div><!-- /.form-group -->
								<div class="form-actions">
									<button type="submit" class="btn btn-success btn-round">
										<i class="icon-check"></i>
										ذخیره
									</button>
									<a href="#" class="btn btn-warning btn-round float-end">
										<i class="icon-close"></i>
										بازگشت
									</a>
								</div><!-- /.form-actions -->
						</form>
					</div><!-- /.col -->
				</div><!-- /.row -->
			</div><!-- /.portlet-body -->
		</div><!-- /.portlet -->
	</div><!-- /.col-12 -->
</div><!-- /.row -->