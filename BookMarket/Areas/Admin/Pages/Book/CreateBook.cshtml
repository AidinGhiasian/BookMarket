@page
@model BookMarket.Areas.Admin.Pages.Book.CreateBookModel
@{
}
<div class="row">
	<!-- BEGIN BREADCRUMB -->
	<div class="col-md-12">
		<div class="breadcrumb-box shadow">
			<ul class="breadcrumb">
				<li><a href="/Admin/Index">پیشخوان</a></li>
				<li><a href="#">لیست ها</a></li>
				<li><a href="/Admin/Book/AdminIndex">مدیریت کتاب ها</a></li>
				<li class="active">ساخت کتاب</li>
			</ul>
			<div class="breadcrumb-left">
				پنجشنبه، 1404/10/4
				<i class="icon-calendar"></i>
			</div><!-- /.breadcrumb-left -->
		</div><!-- /.breadcrumb-box -->
	</div><!-- /.col-md-12 -->
	<!-- END BREADCRUMB -->

	<div class="col-12">
		<div class="portlet box shadow">
			<div class="portlet-heading">
				<div class="portlet-title">
					<h3 class="title">
						<i class="icon-note"></i>
						ساخت کتاب
					</h3>
					<div class="bg-success-subtle" style="margin:100%">
						@if (TempData["success"] != null)
						{
							@TempData["success"]

						}
					</div>

				</div><!-- /.portlet-title -->

			</div><!-- /.portlet-heading -->

			<div class="portlet-body edit-form">

				<div class="row">
					<div class="col-lg-6 col-md-10 m-auto m-b-30">


						<form method="post" enctype="multipart/form-data">
							<div class="form-body">
								<div class="form-group relative mt-3 mb-4">
									<input type="file" asp-for="@Model.books.FileName" name="FileName" class="form-control">
									<div class="input-group round">
										<input type="text" class="form-control file-input" placeholder="برای آپلود کلیک کنید">
										<span class="input-group-btn">
											<button type="button" class="btn btn-success">
												<i class="icon-picture"></i>
												آپلود عکس
												<div class="paper-ripple"><div class="paper-ripple__background"></div><div class="paper-ripple__waves"></div></div>
											</button>
										</span>
									</div><!-- /.input-group -->
									<div class="help-block"></div>
								</div>
								<div class="col-sm-6">
									<div class="form-group">
										<label for="txt-firstname">عنوان کتاب</label>
										<div class="input-group round">
											<span class="input-group-addon">
												<i class="icon-user"></i>
											</span>
											<input type="text" name="BookTitle" asp-for="@Model.books.BookTitle" class="form-control rtl text-right" placeholder="لطفا عنوان کتاب مقاله را وارد نمایید.">
										</div><!-- /.input-group -->
									</div><!-- /.form-group -->
								</div><!-- /.col -->
								<div class="col-sm-6">
									<div class="form-group">
										<label for="txt-firstname">نویسنده</label>
										<div class="input-group round">
											<span class="input-group-addon">
												<i class="icon-user"></i>
											</span>
											<input type="text" name="Writer" asp-for="@Model.books.Writer" class="form-control rtl text-right" placeholder="لطفا عنوان کتاب مقاله را وارد نمایید.">
										</div><!-- /.input-group -->
									</div><!-- /.form-group -->
								</div><!-- /.col -->
								<div class="col-sm-6">
									<div class="form-group">
										<label for="txt-firstname">انتشارات</label>
										<div class="input-group round">
											<span class="input-group-addon">
												<i class="icon-user"></i>
											</span>
											<input type="text" name="Publisher" asp-for="@Model.books.Publisher" class="form-control rtl text-right" placeholder="لطفا عنوان کتاب مقاله را وارد نمایید.">
										</div><!-- /.input-group -->
									</div><!-- /.form-group -->
								</div><!-- /.col -->
								<div class="form-group">
									<label for="txt-mobile">توضیحات کوتاه</label>
									<div class="input-group round">
										<span class="input-group-addon">
											<i class="icon-envelope"></i>
										</span>
										<textarea type="text" style="height: 111px;" asp-for="@Model.books.shortdescription" name="ShortDescription" class="form-control rtl text-right " placeholder="مقدار توضیحات کوتاه باید یا شامل مقدمه یا شامل یک بند خلاصه مقاله شما باشد."></textarea>
									</div><!-- /.input-group -->
								</div><!-- /.form-group -->
								<div class="form-group" style="width: 300px;">
									<label>دسته بندی</label>
									<div class="input-group round" style="width: 200px;">
										<span class="input-group-addon">
											<i class="icon-envelope"></i>
										</span>

										<input type="text" name="CategoryId" asp-for="@Model.books.CategoryId" class="form-control rtl text-Right" placeholder="دسته بندی کتاب">

									</div><!-- /.input-group -->
									<label>قیمت</label>
									<div class="input-group round" style="width: 200px;">
										<span class="input-group-addon">
											<i class="icon-envelope"></i>
										</span>
										<input type="number" name="Price" asp-for="@Model.books.Price" class="form-control rtl text-Right" placeholder="قیمت کتاب"></input>
									</div><!-- /.input-group -->
								</div><!-- /.form-group -->
							</div><!-- /.form-group -->
							<div class="form-actions">
								<button type="submit" class="btn btn-success btn-round">
									<i class="icon-check"></i>
									ذخیره
								</button>
								<a href="#" class="btn btn-warning btn-round float-end">
									<i class="icon-close"></i>
									بازگشت
								</a>
							</div><!-- /.form-actions -->
						</form>
					</div><!-- /.col -->
				</div><!-- /.row -->
			</div><!-- /.portlet-body -->
		</div><!-- /.portlet -->
	</div><!-- /.col-12 -->
</div><!-- /.row -->