@page
@model BookMarket.Areas.Admin.Pages.Event.IndexModel
@{
}
<div id="inner-content">
	<div class="row">
		<!-- BEGIN BREADCRUMB -->
		<div class="col-md-12">
			<div class="breadcrumb-box shadow">
				<ul class="breadcrumb">
					<li><a href="/Admin/Index">پیشخوان</a></li>
					<li><a href="#">جدول‌ها</a></li>
					<li><a href="#" class="active">مدیریت رویداد ها</a></li>
				</ul>
				<div class="breadcrumb-left">
					پنجشنبه، 1404/10/4
					<i class="icon-calendar"></i>
				</div><!-- /.breadcrumb-left -->
			</div><!-- /.breadcrumb-box -->
		</div><!-- /.col-md-12 -->
		<!-- END BREADCRUMB -->
		<div>
			<div>
				@if (TempData["success"] != null)
				{
					<div class="alert alert-success text-center">
						@TempData["success"]
					</div>
				}
				else if (TempData["deleted"] != null)
				{
					<div class="alert alert-success text-center">
						@TempData["deleted"]
					</div>
				}
			</div>
			<div class="col-lg-12">
				<div class="portlet box shadow">
					<div class="portlet-heading">
						<div class="portlet-title">
							<h3 class="title">
								<i class="icon-frane"></i>
								مدیریت رویداد ها
							</h3>
						</div><!-- /.portlet-title -->

					</div><!-- /.portlet-heading -->
					<div class="portlet-body">
						<div class="top-buttons-box mb-2">
							<a class="btn btn-success" asp-page="./Create">
								<i class="icon-plus"></i>
								افزودن
							</a>
						</div><!-- /.top-buttons-box -->

						<div class="table-responsive">
							<table class="table table-bordered table-hover table-striped" id="data-table">
								<thead>
									<tr>
										<th>ردیف</th>
										<th>تصویر</th>
										<th> عنوان رویداد</th>
										<th>توضیحات </th>
										<th>زمان شروع رویداد </th>
										<th>زمان پایان رویداد </th>
										<th>عملیات</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var item in Model.Events)
									{
										<tr>
											<td>@item.Id</td>
											<td>
												<a class="img-thumbnail">
													<img style="width:150px;" src="/Pictures/@item.Picture">
												</a>
											</td>
											<td>@item.EventTitle</td>
											<td>@item.Description</td>
											<td>@item.EventStartTime</td>
											<td>@item.EventFinishTime</td>
											<td>
												<a class="btn btn-info" asp-page="/Event/index" asp-page-handler="Edit" asp-route-id="@item.Id">ویرایش</a>
											</td>
											<td>
												<a class="btn btn-danger" asp-page-handler="delete" asp-route-id="@item.Id">حذف</a>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div><!-- /.table-responsive -->
					</div><!-- /.portlet-body -->
				</div><!-- /.portlet -->
			</div><!-- /.col-lg-12 -->
		</div><!-- /.row -->
	</div><!-- /#inner-content -->
