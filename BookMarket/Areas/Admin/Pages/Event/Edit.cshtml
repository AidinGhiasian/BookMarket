@page
@using Services.Application
@model BookMarket.Areas.Admin.Pages.Event.EditModel
@{
}
<div class="row">
    <!-- BEGIN BREADCRUMB -->
    <div class="col-md-12">
        <div class="breadcrumb-box shadow">
            <ul class="breadcrumb">
                <li><a href="/Admin/Index">پیشخوان</a></li>
                <li><a href="/Admin/Event/AdminIndex"> مدیریت رویداد ها</a></li>
                <li><a href="#" class="active">ویرایش رویداد</a></li>

            </ul>
            <div class="breadcrumb-left">
                @ConvertDateTime.ConvertMiladiToShamsi(DateTime.Now, "HH:mm  dd MMMM yyyy")
                <i class="icon-calendar"></i>
            </div><!-- /.breadcrumb-left -->
        </div><!-- /.breadcrumb-box -->
    </div><!-- /.col-md-12 -->
    <!-- END BREADCRUMB -->

    <div class="col-12">
        <div class="portlet box shadow">
            <div class="portlet-heading">
                <div class="portlet-title">
                    <h3 class="title">
                        <i class="icon-note"></i>
                        ویرایش رویداد
                    </h3>
                </div>

            </div>

            <div class="portlet-body edit-form">

                <div class="row">
                    <div class="col-lg-6 col-md-10 m-auto m-b-30">

                        <form id="form" role="form" method="post" enctype="multipart/form-data">
                            <div class="form-body">
                                <div class="form-group relative mt-3 mb-4">
                                    <input type="file" name="FileName" asp-for="@Model.Events.FileName" class="form-control">
                                    <div class="input-group round">
                                        <input type="text" class="form-control file-input" placeholder="برای آپلود کلیک کنید">
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-success">
                                                <i class="icon-picture"></i>
                                                آپلود عکس
                                                <div class="paper-ripple"><div class="paper-ripple__background"></div><div class="paper-ripple__waves"></div></div>
                                            </button>
                                        </span>
                                    </div><!-- /.input-group -->
                                    <div class="help-block"></div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="txt-firstname">عنوان رویداد</label>
                                        <div class="input-group round">
                                            <span class="input-group-addon">
                                                <i class="icon-user"></i>
                                            </span>
                                            <input type="text" name="EventTitle" asp-for="@Model.Events.EventTitle" class="form-control rtl text-right" placeholder="لطفا عنوان رویداد را وارد نمایید.">
                                        </div><!-- /.input-group -->
                                    </div><!-- /.form-group -->
                                </div><!-- /.col -->
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label>زمان شروع رویداد</label>
                                        <div class="input-group round">
                                            <span class="input-group-addon">
                                                <i class="icon-user"></i>
                                            </span>
                                            <input type="date" name="EventStartTime" asp-for="@Model.Events.EventStartTime" class="form-control rtl text-right" placeholder="لطفا زمان شروع رویداد را وارد نمایید.">
                                        </div><!-- /.input-group -->
                                    </div><!-- /.form-group -->
                                </div><!-- /.col -->
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label>زمان پایان رویداد</label>
                                        <div class="input-group round">
                                            <span class="input-group-addon">
                                                <i class="icon-user"></i>
                                            </span>
                                            <input type="date" name="EventFinishTime" asp-for="@Model.Events.EventFinishTime" class="form-control rtl text-right" placeholder="لطفا زمان پایان رویداد را وارد نمایید.">
                                        </div><!-- /.input-group -->
                                    </div><!-- /.form-group -->
                                </div><!-- /.col -->
                                <div class="form-group" style="width: 390px;">
                                    <div class="form-group">
                                        <label for="txt-email">توضیحات کامل</label>
                                        <div class="input-group round">
                                            <span class="input-group-addon">
                                                <i class="icon-envelope"></i>
                                            </span>
                                            <textarea type="text" style="height: 150px;" name="Description" asp-for="@Model.Events.Description" class="form-control rtl text-Right" placeholder=" توضیخات "></textarea>
                                        </div><!-- /.input-group -->
                                    </div><!-- /.form-group -->
                                    <div class="form-actions">
                                        <button type="submit" class="btn btn-success btn-round">
                                            <i class="icon-check"></i>
                                            ذخیره
                                        </button>
                                        <a href="./AdminIndex" class="btn btn-warning btn-round float-end">
                                            <i class="icon-close"></i>
                                            بازگشت
                                        </a>
                                    </div><!-- /.form-actions -->
                                </div>
                        </form>
                    </div><!-- /.col -->
                </div><!-- /.row -->
            </div><!-- /.portlet-body -->
        </div><!-- /.portlet -->
    </div><!-- /.col-12 -->
</div>
@section AdminScripts {
    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const startInput = document.querySelector("input[name='EventStartTime']");
            const finishInput = document.querySelector("input[name='EventFinishTime']");

            function validateDates() {

                if (!startInput.value || !finishInput.value)
                    return;

                const startDate = new Date(startInput.value);
                const finishDate = new Date(finishInput.value);

                if (startDate >= finishDate) {

                    Swal.fire({
                        icon: 'error',
                        title: 'خطا در تاریخ رویداد',
                        text: 'تاریخ شروع باید کوچکتر از تاریخ پایان باشد.',
                        confirmButtonText: 'متوجه شدم'
                    });

                    // خالی کردن تاریخ پایان برای اصلاح کاربر
                    finishInput.value = "";
                }
            }

            startInput.addEventListener("change", validateDates);
            finishInput.addEventListener("change", validateDates);
        });
    </script>

}