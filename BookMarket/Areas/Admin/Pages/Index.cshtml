@page
@using Services.Application
@model BookMarket.Areas.Admin.Pages.IndexModel
@{
    Layout = "_AdminLayout";
}
<div id="inner-content">
    <div class="row">
        <!-- BEGIN BREADCRUMB -->
        <div class="col-md-12">
            <div class="breadcrumb-box shadow">
                <ul class="breadcrumb">
                    <li><a href="#">پیشخوان</a></li>
                </ul>
                <div class="breadcrumb-left">
                    @ConvertDateTime.ConvertMiladiToShamsi(DateTime.Now, "HH:mm  dd MMMM yyyy")
                    <i class="icon-calendar"></i>
                </div><!-- /.breadcrumb-left -->
            </div><!-- /.breadcrumb-box -->
        </div><!-- /.col-md-12 -->
        <div class="col-md-12">
            <div class="row">
                <div class="col-lg-3 col-6">
                    <div class="stat-box use-blue shadow">
                        <a href="/Admin/Account/AdminIndex">
                            <div class="stat">
                                <div class="h3">مدیریت کاربران</div>
                            </div><!-- /.stat -->
                            <div class="visual">
                                <i class="icon- fas fa-user-large"></i>
                            </div><!-- /.visual -->
                        </a>
                    </div><!-- /.stat-box -->
                </div><!-- /.col-lg-3 -->
                <div class="col-lg-3 col-6">
                    <div class="stat-box use-green shadow">
                        <a href="/Admin/Blog/AdminIndex">
                            <div class="stat">
                                <div class="h3">مدیریت مقالات</div>
                            </div><!-- /.stat -->
                            <div class="visual">
                                <i class="icon- fas fa-file"></i>
                            </div><!-- /.visual -->
                        </a>
                    </div><!-- /.stat-box -->
                </div><!-- /.col-lg-3 -->
                <div class="col-lg-3 col-6">
                    <div class="stat-box use-red shadow">
                        <a href="/Admin/Book/AdminIndex">
                            <div class="stat">
                                <div class="h3">مدیریت کتاب ها</div>
                            </div><!-- /.stat -->
                            <div class="visual">
                                <i class="icon- fas fa-book"></i>
                            </div><!-- /.visual -->
                        </a>
                    </div><!-- /.stat-box -->
                </div><!-- /.col-lg-3 -->
                <div class="col-lg-3 col-6">
                    <div class="stat-box use-orange shadow">
                        <a href="/Admin/Event/Index">
                            <div class="stat">
                                <div class="h3">مدیریت رویداد ها</div>
                            </div><!-- /.stat -->
                            <div class="visual">
                                <i class="icon-event"></i>
                            </div><!-- /.visual -->
                        </a>
                    </div><!-- /.stat-box -->
                </div><!-- /.col-lg-3 -->
                <div class="col-lg-3 col-6">
                    <div class="stat-box use-darkblue shadow">
                        <a href="/Admin/Comment/Index">
                            <div class="stat">
                                <div class="h3">مدیریت دیدگاه ها</div>
                            </div><!-- /.stat -->
                            <div class="visual">
                                <i class="icon- fas fa-comments"></i>
                            </div><!-- /.visual -->
                        </a>
                    </div><!-- /.stat-box -->
                </div><!-- /.col-lg-3 -->
            </div><!-- /.row -->
        </div><!-- /.row -->


        <div class="row">
            <div class="col-md-12 col-xs-12">
                <div class="portlet box shadow min-height-600">
                    <div class="portlet-heading">
                        <div class="portlet-title">
                            <h3 class="title">
                                <i class="icon-speech"></i>
                                دیدگاه‌ها
                            </h3>
                        </div><!-- /.portlet-title -->
                        <div class="buttons-box">
                            <a class="btn btn-sm btn-default btn-round btn-code" rel="tooltip" title="کدها" href="#">
                                <i class="icon-arrow-left"></i><span>/</span><i class="icon-arrow-right"></i>
                            </a>
                            <a class="btn btn-sm btn-default btn-round btn-fullscreen" rel="tooltip" title="تمام صفحه" href="#">
                                <i class="icon-size-fullscreen"></i>
                            </a>
                            <a class="btn btn-sm btn-default btn-round btn-close" rel="tooltip" title="بستن" href="#">
                                <i class="icon-trash"></i>
                            </a>
                        </div><!-- /.buttons-box -->
                    </div><!-- /.portlet-heading -->

                    <div class="portlet-body">
                        <ul class="nav nav-tabs">
                            <li class="nav-item">
                                <a class="nav-link active" data-bs-toggle="tab" name="isStatus" value="0" href="#tab1">آخرین دیدگاه ها </a>
                            </li>


                        </ul>
                        <div class="tab-content">
                            <div id="tab1" class="tab-pane active fade show">
                                @if (Model.Comments != null)
                                {
                                    @foreach (var item in Model.Comments)
                                    {
                                        <div class="comments-box">
                                            <div class="comment-box">
                                                <div class="comment">
                                                    <a href="#">
                                                        <img src="~/assets/images/Default-Avatar.png" class="img-circle" alt="">
                                                        <span class="user">
                                                            @item.FullName
                                                        </span>
                                                    </a>
                                                    <span class="float-end text-muted">
                                                        @item.CommentDateTime
                                                        <i class="icon-clock"></i>
                                                    </span>
                                                    <p>
                                                        @item.Message
                                                    </p>
                                                </div>
                                                <div class="actions">
                                                    <a asp-page-handler="ChangeStatus" asp-route-id="@item.Id" asp-route-status="2" class="btn btn-round btn-icon btn-sm btn-info" rel="tooltip" title="پذیرش">
                                                        <i class="icon-check"></i>
                                                    </a>
                                                    <a asp-page-handler="ChangeStatus" asp-route-id="@item.Id" asp-route-status="3" class="btn btn-round btn-icon btn-sm btn-warning" rel="tooltip" title="عدم پذیرش">
                                                        <i class="icon-close"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }


                            </div>

                        </div>
                    </div>

                </div><!-- /.portlet -->
            </div><!-- /.col-md-6 -->
          
        </div><!-- /.row -->

       
    </div><!-- /.col-md-12 -->
</div><!-- /.row -->
</div><!-- /#inner-content -->