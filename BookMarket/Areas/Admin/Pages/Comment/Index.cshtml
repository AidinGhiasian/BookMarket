@page
@using CommentMInfrastructureConfiguration.Permission
@using Services.Application
@model BookMarket.Areas.Admin.Pages.Comment.IndexModel
@{
}
<div id="inner-content">
    <div class="row">
        <!-- BEGIN BREADCRUMB -->
        <div class="col-md-12">
            <div class="breadcrumb-box shadow">
                <ul class="breadcrumb">
                    <li><a href="/Admin/Index">پیشخوان</a></li>
                    <li class="active">مدیریت دیدگاه ها</li>
                </ul>
                <div class="breadcrumb-left">
                    @ConvertDateTime.ConvertMiladiToShamsi(DateTime.Now, "HH:mm  dd MMMM yyyy")
                    <i class="icon-calendar"></i>
                </div><!-- /.breadcrumb-left -->
            </div><!-- /.breadcrumb-box -->
        </div><!-- /.col-md-12 -->
        <!-- END BREADCRUMB -->
        @if (TempData["success"] != null)
        {
            <div class="alert alert-success text-center">
                @TempData["success"]
            </div>
        }
        <div class="col-lg-12">
            <div class="portlet box shadow">
                <div class="portlet-heading">
                    <div class="portlet-title">
                        <h3 class="title">
                            <i class="icon-frane"></i>
                            مدیریت دیدگاه ها
                        </h3>
                    </div><!-- /.portlet-title -->
                    <div class="buttons-box">
                        <a class="btn btn-sm btn-default btn-round btn-code" rel="tooltip" title="کدها" href="#">
                            <i class="icon-arrow-left"></i><span>/</span><i class="icon-arrow-right"></i>
                        </a>
                        <a class="btn btn-sm btn-default btn-round btn-fullscreen" rel="tooltip" title="تمام صفحه" href="#">
                            <i class="icon-size-fullscreen"></i>
                        </a>
                    </div><!-- /.buttons-box -->
                </div><!-- /.portlet-heading -->
                <div class="portlet-body">
                    <div class="top-buttons-box mb-2 ">
                    </div><!-- /.top-buttons-box -->
                    <form method="get">
                        <div class="custom-radio rtl ">
                            <input  name="isStatus" value="1"  type="radio" class="control-input">
                            <span>
                                خوانده نشده
                            </span>
                            <input name="isStatus" value="2"  type="radio" class="control-input">
                            <span>
                                تایید شده
                            </span>
                            <input name="isStatus" value="3"  type="radio" class="control-input">
                            <span>
                                 رد شده
                            </span>
                            <button type="submit" asp-page="/Admin/Comment/Index" class="btn btn-outline-primary-2 float-right">اعمال</button>
                        </div>
                    </form>
                        <div class="table-responsive">
                        <table class="table table-bordered table-hover table-striped" id="data-table">
                            <thead>
                                <tr class="text-center">
                                    <th>ردیف</th>
                                    <th>نام کاربر</th>
                                    <th>دیدگاه</th>
                                    <th>تاریخ ثبت دیدگاه</th>
                                    <th permission="@CommentPermission.ApprovingCommnet">تایید / عدم تایید</th>
                                    <th permission="@CommentPermission.AnswerCommnet">پاسخ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Comments != null)
                                {
                                    @foreach (var item in Model.Comments)
                                    {
                                        <tr>
                                            <td>@item.Id</td>
                                            <td>@item.FullName</td>
                                            <td>@item.Message</td>
                                            <td>@item.CommentDateTime</td>
                                            <td>
                                                @if (item.IsStatus == 1)
                                                {
                                                    <a permission="@CommentPermission.ApprovingCommnet" class="btn btn-danger" asp-page="./index" asp-page-handler="ChangeStatus" asp-route-id="@item.Id" asp-route-isStatus="3">عدم تایید</a>
                                                    <a permission="@CommentPermission.ApprovingCommnet" class="btn btn-success text-center" asp-page="./index" asp-page-handler="ChangeStatus" asp-route-id="@item.Id" asp-route-isStatus="2">تایید</a>

                                                }
                                                @if (item.IsStatus == 2)
                                                {
                                                    <a permission ="@CommentPermission.ApprovingCommnet" class="btn btn-danger" asp-page="./Index" asp-page-handler="ChangeStatus" asp-route-id="@item.Id" asp-route-isStatus="3">عدم تایید</a>
                                                }
                                                else if(item.IsStatus==3)
                                                {
                                                    <a permission="@CommentPermission.ApprovingCommnet" class="btn btn-success text-center" asp-page="./Index" asp-page-handler="ChangeStatus" asp-route-id="@item.Id" asp-route-isStatus="2">تایید</a>
                                                    <a permission="@CommentPermission.DeleteComment" class="btn btn-danger" asp-page="./Index" asp-page-handler="Delete" asp-route-id="@item.Id">حذف کامل</a>
                                                }
                                             </td>
                                            <td>
                                                <a permission="@CommentPermission.AnswerCommnet" class="btn btn-warning" asp-route-id="@item.Id">پاسخ</a>
                                            </td>

                                        </tr>
                                    }
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>