		<div class="col-6 m-auto">
			<div class="portlet box shadow">
				<div class="portlet-heading">
					<div class="portlet-title">
						<h3 class="title">
							<i class="icon-note"></i>
							خروج از سیستم
						</h3>
					</div><!-- /.portlet-title -->

				</div><!-- /.portlet-heading -->

				<div class="portlet-body edit-form">

					<div class="row">
						<div class="col-lg-12 col-md-12 m-auto m-b-30">


							<form id="form" role="form" method="post">
								<div class="form-body">

									<div class="row">
										<div class="col-sm-12">
											<div class="form-group">

												<div class="alert alert-info">
													<strong>
														آیا از خروج مطمئن هستید ؟ در صورت خروج شما به صورت کامل از سیستم خارج می شوید و برای ادامه کار در این صفحه باید دوباره لاگین کنید .
													</strong>
												</div><!-- /.input-group -->
											</div><!-- /.form-group -->
										</div><!-- /.col -->

									</div><!-- /.row -->


								</div><!-- /.form-body -->

								<div class="form-actions">
