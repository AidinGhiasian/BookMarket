@page
@model BookMarket.Areas.Admin.Pages.Account.ChangePasswordModel
@{
}
<div class="modal-page shadow">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-12">
                <h2 class="text-center m-b-20">‌رمز عبور جدید</h2>
                <hr>

                <form id="advanced-form" method="post">
                    <input type="hidden" asp-for="@Model.Password.Id" />
                    <div class="form-group">
                        <div class="input-group">
                            <span class="input-group-addon">
                                <i class="icon-note"></i>
                            </span>
                            <input type="password" class="form-control round" asp-for="@Model.Password.Password" name="Password" placeholder="رمز عبور جدید" />
                        </div>
                    </div>
                    <br />
                    <div class="form-group">
                        <div class="input-group">
                            <span class="input-group-addon">
                                <i class="icon-note"></i>
                            </span>
                            <input type="password" class="form-control round" asp-for="@Model.Password.RePassword" name="RePassword" placeholder="تکرار رمز عبور جدید">
                        </div>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-success btn-block" value="Sign up">
                            <i class="icon-check"></i>
                            بروزرسانی
                        </button>
                    </div>
                </form>
            </div><!-- /.col-md-12 -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div><!-- /.modal-page -->