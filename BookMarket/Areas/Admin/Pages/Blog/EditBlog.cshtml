@page
@using Services.Application
@model BookMarket.Areas.Admin.Pages.Blog.EditBlogModel
@{
}
<div class="row">
    <!-- BEGIN BREADCRUMB -->
    <div class="col-md-12">
        <div class="breadcrumb-box shadow">
            <ul class="breadcrumb">
                <li><a href="dashboard.html">پیشخوان</a></li>
                <li class="active">ویرایش مقاله</li>
            </ul>
            <div class="breadcrumb-left">
                @ConvertDateTime.ConvertMiladiToShamsi(DateTime.Now, "HH:mm  dd MMMM yyyy")

                <i class="icon-calendar"></i>
            </div><!-- /.breadcrumb-left -->
        </div><!-- /.breadcrumb-box -->
    </div><!-- /.col-md-12 -->
    <!-- END BREADCRUMB -->

    <div class="col-12">
        <div class="portlet box shadow">
            <div class="portlet-heading">
                <div class="portlet-title">
                    <h3 class="title">
                        <i class="icon-note"></i>
                        ویرایش مقاله
                    </h3>
                </div><!-- /.portlet-title -->

            </div><!-- /.portlet-heading -->

            <div class="portlet-body edit-form">

                <div class="row">
                    <div class="col-lg-6 col-md-10 m-auto m-b-30">




                        <form id="form" role="form" method="post" enctype="multipart/form-data">

                            <div class="form-body">
                                <div class="form-group relative mt-3 mb-4">
                                    <input type="file" class="form-control file-input" name="FileName" asp-for="@Model.Blog.FileName" placeholder="برای آپلود کلیک کنید">
                                    <input class="form-control" hidden name="Id" asp-for="@Model.Blog.Id">
                                    <div class="input-group round">
                                        <input type="text" name="Picture" asp-for="@Model.Blog.Picture" class="form-control file-input" placeholder="برای آپلود کلیک کنید">
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-success">
                                                <i class="icon-picture"></i>
                                                آپلود عکس
                                                <div class="paper-ripple"><div class="paper-ripple__background"></div><div class="paper-ripple__waves"></div></div>
                                            </button>
                                        </span>
                                    </div><!-- /.input-group -->
                                    <div class="help-block"></div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="txt-firstname">عنوان مقاله</label>
                                        <div class="input-group round">
                                            <span class="input-group-addon">
                                                <i class="icon-user"></i>
                                            </span>
                                            <input type="text" asp-for="@Model.Blog.Title" name="Title" class="form-control rtl text-right" placeholder="لطفا عنوان مقاله را وارد نمایید.">
                                        </div><!-- /.input-group -->
                                    </div><!-- /.form-group -->
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <label asp-for="@Model.Blog.BlogCategoryId" class="control-label">دسته بندی</label>
                                                <select type="text" class="form-control" name="BlogCategoryId" asp-for="@Model.Blog.BlogCategoryId" asp-items='new SelectList(@Model.BlogCategories, "Id", "Name")'>
                                                    <option value="0">انتخاب دسته بندی ....</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txt-mobile">توضیحات کوتاه</label>
                                        <div class="input-group round">
                                            <span class="input-group-addon">
                                                <i class="icon-envelope"></i>
                                            </span>
                                            <textarea type="text" style="height: 111px;" name="ShortDescription" asp-for="@Model.Blog.ShortDescription" class="form-control rtl text-right " placeholder="مقدار توضیحات کوتاه باید یا شامل مقدمه یا شامل یک بند خلاصه مقاله شما باشد."></textarea>
                                        </div><!-- /.input-group -->
                                    </div><!-- /.form-group -->

                                    <div class="form-group">
                                        <label for="txt-email">توضیحات کامل</label>
                                        <div class="input-group round">
                                            <span class="input-group-addon">
                                                <i class="icon-envelope"></i>
                                            </span>
                                            <textarea type="text" style="height: 456px;" name="Description" asp-for="@Model.Blog.Description" class="form-control rtl text-Right" placeholder=" توضیخات باید به صورت کامل باشد و تمام متن مقاله از مقدمه تا بخش پایانی در آن وارد شود. "></textarea>
                                        </div><!-- /.input-group -->
                                    </div><!-- /.form-group -->
                                <div class="col-sm-6">
                                   

                                    <div class="form-actions">
                                        <button type="submit" class="btn btn-success btn-round">
                                            <i class="icon-check"></i>
                                            ذخیره
                                        </button>
                                        <a href="#" class="btn btn-warning btn-round float-end">
                                            <i class="icon-close"></i>
                                            بازگشت
                                        </a>
                                    </div><!-- /.form-actions -->

                        </form>
                    </div><!-- /.col -->
                </div><!-- /.row -->
            </div><!-- /.portlet-body -->
        </div><!-- /.portlet -->
    </div><!-- /.col-12 -->
</div><!-- /.row -->
