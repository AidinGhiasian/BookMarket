@page
@model BookMarket.Areas.Admin.Pages.Blog.IndexModel
@{
}
<div id="inner-content">
	<div class="row">
		<!-- BEGIN BREADCRUMB -->
		<div class="col-md-12">
			<div class="breadcrumb-box shadow">
				<ul class="breadcrumb">
					<li><a href ="/Admin/Index">پیشخوان</a></li>
					<li><a href="#">جدول‌ها</a></li>
					<li><a href="#" class="active">مدیریت مقالات</a></li>
				</ul>
				<div class="breadcrumb-left">
					پنجشنبه، 1404/10/4
					<i class="icon-calendar"></i>
				</div><!-- /.breadcrumb-left -->
			</div><!-- /.breadcrumb-box -->
		</div><!-- /.col-md-12 -->
		<!-- END BREADCRUMB -->
		<div>
			<div>
				@if (TempData["success"] != null)
				{
					<div class="alert alert-success text-center">
						@TempData["success"]
					</div>
				}
				else if (TempData["deleted"] != null)
				{
					<div class="alert alert-success text-center">
						@TempData["deleted"]
					</div>
				}
			</div>
			<div class="col-lg-12">
				<div class="portlet box shadow">
					<div class="portlet-heading">
						<div class="portlet-title">
							<h3 class="title">
								<i class="icon-frane"></i>
								مدیریت مقالات
							</h3>
						</div><!-- /.portlet-title -->
						<div class="buttons-box">
							<a class="btn btn-sm btn-default btn-round btn-code" rel="tooltip" title="کدها" href="#">
								<i class="icon-arrow-left"></i><span>/</span><i class="icon-arrow-right"></i>
							</a>
							<a class="btn btn-sm btn-default btn-round btn-fullscreen" rel="tooltip" title="تمام صفحه" href="#">
								<i class="icon-size-fullscreen"></i>
							</a>
							<a class="btn btn-sm btn-default btn-round btn-collapse" rel="tooltip" title="کوچک کردن" href="#">
								<i class="icon-arrow-up"></i>
							</a>
						</div><!-- /.buttons-box -->
					</div><!-- /.portlet-heading -->
					<div class="portlet-body">
						<div class="top-buttons-box mb-2">
							<a class="btn btn-success" href="./CreateBlog">
								<i class="icon-plus"></i>
								افزودن
							</a>
						</div><!-- /.top-buttons-box -->

						<div class="table-responsive">
							<table class="table table-bordered table-hover table-striped" id="data-table">
								<thead>
									<tr>
										<th>ردیف</th>
										<th>تصویر</th>
										<th>عنوان</th>
										<th>توضیحات کوتاه</th>
										<th>عملیات</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var item in Model.Blogs)
									{
										<tr>
											<td>@item.Id</td>
											<td>
												<a class="img-thumbnail">
													<img style="width:150px;" src="/Pictures/@item.Picture">

												</a>
											</td>
											<td>@item.Title</td>
											<td>@item.ShortDescription</td>
											<td>
												<a class="btn btn-info" asp-page="/Blog/EditBlog" asp-page-handler="Edit" asp-route-id="@item.Id">ویرایش</a>
											</td>
											<td>
												<a class="btn btn-danger" asp-page-handler="delete" asp-route-id="@item.Id">حذف</a>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div><!-- /.table-responsive -->
					</div><!-- /.portlet-body -->
				</div><!-- /.portlet -->
			</div><!-- /.col-lg-12 -->
		</div><!-- /.row -->
	</div><!-- /#inner-content -->
