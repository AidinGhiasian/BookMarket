@using Services.Application.AuthHelper
@inject IAuthHelper authHelper;
@{
    var account = authHelper.CurrentAccountInfo();
}
<div class="top-bar">
    <ul class="nav navbar-nav navbar-right">
        <li>
            <a href="#" class="btn" id="toggle-sidebar">
                <span class="menu"></span>
            </a>
        </li>
        <li>
            <a href="#" class="btn open" id="toggle-sidebar-top">
                <i class="icon-user-following"></i>
            </a>
        </li>
        <li>
            <a href="#" class="btn " id="toggle-dark-mode">
                <i class="icon-bulb"></i>
            </a>
        </li>
        <li>
            <a href="~/Index" class="btn open" id="toggle-sidebar-top">
                <i class=" fas fa-dumpster"></i>
            </a>
        </li>
    </ul>
    <ul class="nav navbar-nav navbar-left">
        <li class="dropdown">
            <a href="#" class="btn" id="toggle-fullscreen">
                <i class="icon-size-fullscreen"></i>
            </a>
        </li>
        <li class="dropdown dropdown-user">
            <a href="#" class="dropdown-toggle dropdown-hover" data-bs-toggle="dropdown">
                <img src="~/assets/images/Default-Avatar.png" style="width:46px;" alt="ادمین" class="img-circle img-responsive">
                <span>@account.Fullname</span>
                <i class="icon-arrow-down"></i>
            </a>
            <ul class="dropdown-menu">
                <li>
                    <a href="/Admin/Account/EditAccount?id=@account.Id">
                        <i class="icon-note"></i>
                        ویرایش پروفایل
                    </a>
                </li>
                <li>
                    <a href="/Admin/Account/ChangePassword">
                        <i class="icon-key"></i>
                        تغییر رمز‌عبور
                    </a>
                </li>
                <li>
                    <a href="/Admin/Logout">
                        <i class="icon-power"></i>
                        خروج
                    </a>
                </li>
            </ul>
        </li>
        @*                اعلان ها و خبر های مدیریتی پنل ادمین برداشته شده است!  *@
    </ul><!-- /.navbar-left -->
</div>