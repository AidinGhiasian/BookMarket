@page
@model BookMarket.Pages.Book.IndexModel
@{
}
<div class="page-header text-center" style="background-image: url('assets/images/page-header-bg.jpg')">
    <div class="container">
        <h1 class="page-title">کتاب ها</h1>
    </div><!-- End .container -->
</div><!-- End .page-header -->
<nav aria-label="breadcrumb" class="breadcrumb-nav mb-2">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/index">خانه</a></li>
            @if (Model.BooksWithCategory == null)
            {
                <li class="breadcrumb-item active"><a href="/Book/Index">کتاب ها</a></li>

            }else if (Model.BooksWithCategory != null)
            {
                <li class="breadcrumb-item "><a href="/Book/index">کتاب ها</a></li>

                <li class="breadcrumb-item active"><a href="#">@Model.BooksWithCategory.First().CategoryName</a></li>
            }
        </ol>
    </div><!-- End .container -->
</nav><!-- End .breadcrumb-nav -->

<div class="page-content">
    <div class="container">
        <nav class="blog-nav">
            <ul class="menu-cat entry-filter justify-content-center">
                <li class=""><a href="/Book/Index" data-filter="*">همه<span></span></a></li>

                @if (Model.Categories != null)
                {
                    @foreach (var item in Model.Categories)
                    {
                        <li class="@((Model.BooksWithCategory != null) ? "active" : "") "><a href="/Blog/Index?id=@item.Id" data-filter="*">@item.CategoryName<span></span></a></li>

                    }
                }

            </ul><!-- End .blog-menu -->
        </nav><!-- End .blog-nav -->

        <div class="entry-container max-col-4">
            @if (Model.Books != null)
            {
                @foreach (var item in Model.Books)
                {
                    <div class="entry-item lifestyle shopping col-sm-6 col-md-4 col-lg-3">
                        <article class="entry entry-grid text-center">
                            <figure class="entry-media">
                                <a href="/Book/BookDetails?id=@item.Id">
                                    <img src="/Pictures/@item.PictureFile" alt="توضیحات عکس">
                                </a>
                            </figure><!-- End .entry-media -->

                            <div class="entry-body">
                                <div class="entry-meta">
                                    <a href="#">22 اسفند 1401</a>
                                    <span class="meta-separator">|</span>
                                    <a href="#">2 دیدگاه</a>
                                </div><!-- End .entry-meta -->

                                <h2 class="entry-title text-center">
                                    <a href="/Book/BookDetails?id=@item.Id">@item.BookTitle</a>
                                </h2><!-- End .entry-title -->

                                <div class="entry-cats text-center">

                                    <a href="#">@item.CategoryName </a>


                                </div><!-- End .entry-cats -->
                            </div><!-- End .entry-body -->
                        </article><!-- End .entry -->
                    </div>

                }

            }
            else if (Model.BooksWithCategory != null)
            {
                @foreach (var item in Model.BooksWithCategory)
                {
                    <div class="entry-item lifestyle shopping col-sm-6 col-md-4 col-lg-3">
                        <article class="entry entry-grid text-center">
                            <figure class="entry-media">
                                <a href="/Book/BookDetails">
                                    <img src="/Pictures/@item.PictureFile" alt="توضیحات عکس">
                                </a>
                            </figure><!-- End .entry-media -->

                            <div class="entry-body">
                                <div class="entry-meta">
                                    <a href="#">22 اسفند 1401</a>
                                    <span class="meta-separator">|</span>
                                    <a href="#">2 دیدگاه</a>
                                </div><!-- End .entry-meta -->

                                <h2 class="entry-title text-center">
                                    <a href="/Book/BookDetails">@item.BookTitle</a>
                                </h2><!-- End .entry-title -->

                                <div class="entry-cats text-center">

                                    <a href="#">@item.CategoryName</a>


                                </div><!-- End .entry-cats -->
                            </div><!-- End .entry-body -->
                        </article><!-- End .entry -->
                    </div>

                }
            }

        </div><!-- End .entry-container -->

        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item disabled">
                    <a class="page-link page-link-prev" href="#" aria-label="Previous" tabindex="-1"
                       aria-disabled="true">
                        <span aria-hidden="true"><i class="icon-long-arrow-right"></i></span>قبلی
                    </a>
                </li>
                <li class="page-item active" aria-current="page"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item">
                    <a class="page-link page-link-next" href="#" aria-label="Next">
                        بعدی<span aria-hidden="true"><i class="icon-long-arrow-left"></i></span>
                    </a>
                </li>
            </ul>
        </nav>
    </div><!-- End .container -->
</div><!-- End .page-content -->