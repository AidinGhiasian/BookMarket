@page
@model BookMarket.Pages.CreateBookModel
@{
}
<nav aria-label="breadcrumb" class="breadcrumb-nav border-0 mb-0">
	<div class="container">
		<ol class="breadcrumb">
			<li class="breadcrumb-item"><a href="index-1.html">خانه</a></li>
			<li class="breadcrumb-item"><a href="#">صفحات</a></li>
			<li class="breadcrumb-item active" aria-current="page">ساخت کتاب</li>
		</ol>
	</div><!-- End .container -->
</nav><!-- End .breadcrumb-nav -->

<div class="login-page bg-image pt-8 pb-8 pt-md-12 pb-md-12 pt-lg-17 pb-lg-17"
	 style="background-image: url('assets/images/backgrounds/login-bg.jpg')">
	<div class="container">
		<div class="form-box" style="max-width: 1000px;">
			<div class="form-tab">
				<ul class="nav nav-pills nav-fill " role="tablist">
					<li class="nav-item">
						<a class="nav-link" id="signin-tab-2" data-toggle="tab" href="" role="tab"
						   aria-controls="" aria-selected="false">ساخت کتاب</a>
					</li>
				</ul>
				<div class="tab-content">
					<div class="tab-pane fade" id="signin-2" role="tabpanel" aria-labelledby="signin-tab-2">
						<div class="form-choice">
						</div><!-- End .col-6 -->
					</div><!-- End .row -->
				</div><!-- End .form-choice -->
			</div><!-- .End .tab-pane -->
			<div class="tab-pane fade show active" id="register-2" role="tabpanel"
				 aria-labelledby="register-tab-2">
				@if (TempData["success"] != null)
				{
					<div class="alert alert-success rtl">
						@TempData["success"]
					</div>
				}
				<form method="post" enctype="multipart/form-data">

					<div class="form-group " style="width: 391px;">
						<label>عنوان کتاب</label>
						<p></p>
						<input style="height: 40px; width: 348px;" class="form-control"
							   name="BookTitle" required>
					</div><!-- End .form-group -->

					<div class="form-group " style="width: 391px;">
						<label>آدرس تصویر کتاب(alt)</label>
						<input type="file" style="height: 40px; width: 348px;" class="form-control"
							   name="FileName" required>
					</div><!-- End .form-group -->

					<div class="form-group" style="width: 391px;">
						<label>نویسنده</label>
						<p></p>
						<input class="form-control" style="height: 40px; width: 348px;" 
						name="Writer" id=""></input>
					</div><!-- End .form-group -->

					<div class="form-group" style="width: 391px;">
						<label>ناشر کتاب </label>
						<p></p>
						<input class="form-control" style="height: 40px; width: 348px;"
							   name="Publisher" id=""></input>
					</div><!-- End .form-group -->
					<div class="form-group" style="width: 391px;">
						<label for="body">توضیحات کوتاه درباره کتاب</label>
						<textarea class="form-control" style="height: 40px; width: 342px;" name="ShortDescription" id=""></textarea>
					</div><!-- End .form-group -->

					<div class="form-footer">
						<button type="submit" class="btn btn-outline-primary-2">
							<span>ثبت کتاب</span>
							<i class="icon-long-arrow-left"></i>
						</button>
					</div>
				</form>
				<div class="form-choice">
				</div><!-- End .col-6 -->
			</div><!-- End .row -->
		</div><!-- End .form-choice -->
	</div><!-- .End .tab-pane -->
</div><!-- End .tab-content -->
