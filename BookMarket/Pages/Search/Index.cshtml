@page
@using Services.Application
@model BookMarket.Pages.Search.IndexModel

@{
}
<div class="page-header text-center" style="background-image: url('assets/images/page-header-bg.jpg')">
    <div class="container">
        <h1 class="page-title">جستجو </h1>
    </div><!-- End .container -->
</div><!-- End .page-header -->

<div class="page-content">
   
        <div class="entry-container max-col-4 row" data-layout="fitRows">
            @if (Model.Books != null)
            {
                @foreach (var item in Model.Books)
                {
                    <div class="entry-item lifestyle fashion col-sm-6 col-md-4 col-lg-3">
                        <article class="entry entry-grid text-center">
                            <figure class="entry-media">
                                <div>
                                    <a href="/Blog/BlogDetails?Id=@item.Id">
                                        <img src="/Pictures/@item.PictureFile" alt="توضیحات عکس">
                                    </a>
                                </div><!-- End .owl-carousel -->
                            </figure><!-- End .entry-media -->

                            <div class="entry-body">
                                <div class="entry-meta">
                                    <a href="#">@item.CreateDateTime</a>
                                    <span class="meta-separator">|</span>
                                    <a href="#">3 دیدگاه</a>
                                </div><!-- End .entry-meta -->

                                <h2 class="entry-title text-center">
                                    <a href="/Blog/BlogDetails?Id=@item.Id">@item.BookTitle</a>
                                </h2><!-- End .entry-title -->

                                <div class="entry-cats text-center">
                                    <a href="#">@item.CategoryName</a>
                                </div><!-- End .entry-cats -->

                                <div class="entry-content text-center">
                                    <p>
                                        @item.ShortDescription.Truncate(100)
                                    </p>
                                    <a href="/Blog/BlogDetails?Id=@item.Id" class="read-more">
                                        ادامه
                                        خواندن
                                    </a>
                                </div><!-- End .entry-content -->
                            </div><!-- End .entry-body -->
                        </article><!-- End .entry -->
                    </div>

                }
            }
            @if (Model.Posts != null)
            {
                @foreach (var item in Model.Posts)
                {
                    <div class="entry-item lifestyle fashion col-sm-6 col-md-4 col-lg-3">
                        <article class="entry entry-grid text-center">
                            <figure class="entry-media">
                                <div>
                                    <a href="/Blog/BlogDetails?Id=@item.Id">
                                        <img src="/Pictures/@item.Picture" alt="توضیحات عکس">
                                    </a>
                                </div><!-- End .owl-carousel -->
                            </figure><!-- End .entry-media -->

                            <div class="entry-body">
                                <div class="entry-meta">
                                    <a href="#">@item.PostTime</a>
                                    <span class="meta-separator">|</span>
                                    <a href="#">3 دیدگاه</a>
                                </div><!-- End .entry-meta -->

                                <h2 class="entry-title text-center">
                                    <a href="/Blog/BlogDetails?Id=@item.Id">@item.Title</a>
                                </h2><!-- End .entry-title -->

                                <div class="entry-cats text-center">
                                    <a href="#">@item.Category</a>
                                </div><!-- End .entry-cats -->

                                <div class="entry-content text-center">
                                    <p>
                                        @item.ShortDescription
                                    </p>
                                    <a href="/Blog/BlogDetails?Id=@item.Id" class="read-more">
                                        ادامه
                                        خواندن
                                    </a>
                                </div><!-- End .entry-content -->
                            </div><!-- End .entry-body -->
                        </article><!-- End .entry -->
                    </div>

                }
            }
        </div>

        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item disabled">
                    <a class="page-link page-link-prev" href="#" aria-label="Previous" tabindex="-1"
                       aria-disabled="true">
                        <span aria-hidden="true"><i class="icon-long-arrow-right"></i></span>قبلی
                    </a>
                </li>
                <li class="page-item active" aria-current="page"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item">
                    <a class="page-link page-link-next" href="#" aria-label="Next">
                        بعدی<span aria-hidden="true"><i class="icon-long-arrow-left"></i></span>
                    </a>
                </li>
            </ul>
        </nav>
    </div><!-- End .container -->
</div><!-- End .page-content -->