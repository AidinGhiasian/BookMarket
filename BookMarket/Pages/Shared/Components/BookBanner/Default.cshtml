@using BookM.ClientQueries.Model.Book.Books
@model List<BookQueryViewModel>?
@{
}
<div class="col-sm-6 col-lg-3">
    @foreach (var item in Model)
    {

        <div class="banner banner-overlay">
            <a href="#">
                <img src="/Pictures/@item.PictureFile" alt="بنر">
            </a>

            <div class="banner-content banner-content-stretch">
                <h4 class="banner-subtitle text-white"><a href="#">جدید در این هفته</a></h4>
                <!-- End .banner-subtitle -->
                <h3 class="banner-title text-white">
                    <a href="#">
                        @item.BookTitle
                    </a>
                </h3><!-- End .banner-title -->
                <a asp-page="././././Blog/BookDetails"asp-route-id="@item.Id" class="btn btn-outline-white-3 banner-link">
                    مشاهده<i class="icon-long-arrow-left"></i>
                </a>
            </div><!--به طور فعلی صفحه بلاگ دیتیلز وجود ندارد بنا براین تگ مشاهده به مپ ایراد میگیرد -->
        </div>
    }
</div> 
