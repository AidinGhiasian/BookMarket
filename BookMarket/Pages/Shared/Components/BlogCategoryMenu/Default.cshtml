@using BookM.ClientQueries.Blog.Categores
@model List<BlogCategoryQueryViewModel>

@if (Model != null && Model.Any())
{
    <div class="megamenu megamenu-sm">
        <div class="row no-gutters">
            <div class="col-md-6">
                <div class="menu-col">
                    <div class="menu-title">
                        <a href="/Blog/Index">همه مقالات</a>
                    </div>

                    <ul>
                        @foreach (var item in Model)
                        {
                            <li>
                                <a href="~/Blog/index?id=@item.Id">
                                    @item.Name
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="col-md-6">
                @{
                    var lastCategory = Model.LastOrDefault();
                }

                <div class="banner banner-overlay">
                    <a href="category.html">
                        <img src="/Pictures/@Model.LastOrDefault().Picture" alt="Banner">

                        <div class="banner-content banner-content-bottom">
                            <div class="banner-title text-white">
                                محصولات
                                جدید<br>
                                <span><strong>بهار 1401</strong></span>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
}