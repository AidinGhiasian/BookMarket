@page
@model BookMarket.Pages.Account.loginModel
@{
    Layout = "_Layout";
}

<nav aria-label="breadcrumb" class="breadcrumb-nav border-0 mb-0">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-page="/Index">خانه</a>
            </li>
            <li class="breadcrumb-item active">
                ورود / ثبت نام
            </li>
        </ol>
    </div>
</nav>

<div class="login-page bg-image pt-8 pb-8"
     style="background-image:url('/assets/images/backgrounds/login-bg.jpg')">

    <div class="container">

        <div class="form-box">

            <div class="form-tab">

                <ul class="nav nav-pills nav-fill" role="tablist">

                    <li class="nav-item">
                        <a class="nav-link active"
                           id="signin-tab-2"
                           data-toggle="tab"
                           href="#signin-2"
                           role="tab"
                           aria-controls="signin-2"
                           aria-selected="true">
                            ورود
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           id="register-tab-2"
                           data-toggle="tab"
                           href="#register-2"
                           role="tab"
                           aria-controls="register-2"
                           aria-selected="false">
                            ثبت نام
                        </a>
                    </li>

                </ul>

                <div class="tab-content">

                    <!-- Login -->

                    <div class="tab-pane fade show active"
                         id="signin-2"
                         role="tabpanel"
                         aria-labelledby="signin-tab-2">

                        <form method="post" asp-page-handler="Login">
                                <div class="form-group">
                                    <label >شماره همراه</label>
                                    <input type="text" class="form-control" 
                                       name="phone" required>
                                </div><!-- End .form-group -->

                                <div class="form-group">
                                    <label for="singin-password-2">رمز عبور *</label>
                                    <input type="password" class="form-control" id="singin-password-2"
                                       name="password" required>
                                </div><!-- End .form-group -->

                            <div class="form-footer">

                                <button type="submit"
                                        class="btn btn-outline-primary-2">
                                    <span>ورود</span>
                                </button>

                            </div>

                        </form>

                    </div>

                    <!-- Register -->

                    <div class="tab-pane fade"
                         id="register-2"
                         role="tabpanel"
                         aria-labelledby="register-tab-2">

                        <form method="post"
                              asp-page-handler="Register"
                              enctype="multipart/form-data">

                            <div class="form-group">
                                <label>نام</label>
                                <input name="Name"
                                       class="form-control"
                                       required />
                            </div>

                            <div class="form-group">
                                <label>نام خانوادگی</label>
                                <input name="Family"
                                       class="form-control"
                                       required />
                            </div>

                            <div class="form-group">
                                <label>شماره موبایل</label>
                                <input name="PhoneNumber"
                                       class="form-control"
                                       required />
                            </div>

                        
                        

                        

                            <div class="form-group">
                                <label>رمز عبور</label>
                                <input type="password"
                                       name="Password"
                                       class="form-control"
                                       required />
                            </div>

                       

                            <div class="form-footer">

                                <button type="submit"
                                        class="btn btn-outline-primary-2">
                                    <span>ثبت نام</span>
                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>