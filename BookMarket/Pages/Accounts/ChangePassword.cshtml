@page
@model BookMarket.Pages.Accounts.ChangePasswordModel
@{
}
<main class="main">
    <nav aria-label="breadcrumb" class="breadcrumb-nav border-0 mb-0">
        <div class="container">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="index-1.html">خانه</a></li>
                <li class="breadcrumb-item"><a href="#">صفحات</a></li>
                <li class="breadcrumb-item active" aria-current="page">فراموشی رمز عبور</li>
            </ol>
        </div><!-- End .container -->
    </nav><!-- End .breadcrumb-nav -->

    <div class="login-page bg-image pt-8 pb-8 pt-md-12 pb-md-12 pt-lg-17 pb-lg-17"
         style="background-image: url('/assets/images/backgrounds/login-bg.jpg')">
        <div class="container">
            <div class="form-box">
                <div class="row m-0">
                    <div class="col-12 p-0">
                        <form method="post">
                            <h3 class="mb-4 mt-3 text-center">ایجاد رمز عبور جدید</h3>
	                        <div class="form-group">
                                <input type="hidden" asp-for="@Model.Password.Id" />
                                <label>رمز عبور جدید</label>
                                <input type="password" class="form-control" id="register-password-3"
                                       name="Password" asp-for="@Model.Password.Password" placeholder="*********" required="">
                            </div>
                            <div class="form-group">
                                <label>تکرار رمز عبور جدید</label>
                                <input type="password" class="form-control" id="register-password-4"
                                       name="RePassword"asp-for="@Model.Password.RePassword" placeholder="*********" required="">
                            </div>
	                        <div class="form-group mt-3">
                                <button class="btn btn-outline-primary-2 btn-block" type="submit">
                                    بروزرسانی
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div><!-- End .form-box -->
        </div><!-- End .container -->
    </div><!-- End .login-page section-bg -->
</main>
