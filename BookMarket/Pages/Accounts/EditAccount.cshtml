@page
@using Services.Application.AuthHelper
@model BookMarket.Pages.Accounts.EditAccountModel
@inject IAuthHelper AccountInfo;
@{
    var account = AccountInfo.CurrentAccountInfo();
}

<nav aria-label="breadcrumb" class="breadcrumb-nav border-0 mb-0">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Index">خانه</a></li>
            <li class="breadcrumb-item"><a href="/Dashboard">داشبورد</a></li>
            <li class="breadcrumb-item active" aria-current="page">ویرایش اطلاعات</li>
        </ol>
    </div><!-- End .container -->
</nav><!-- End .breadcrumb-nav -->

<div class="login-page bg-image pt-8 pb-8 pt-md-12 pb-md-12 pt-lg-17 pb-lg-17"
     style="background-image: url('/assets/images/backgrounds/login-bg.jpg')">
    <div class="container">
        <div class="form-box">
            <div class="row m-0">
                <div class="col-12 p-0">
                    <form method="post">
                        <h3 class="mb-4 mt-3 text-center">ویرایش اطلاعات</h3>
                        <input type="hidden" asp-for="@account.Id" />
                        <input type="file" name="Picture" asp-for="@Model.Account.PictureName" class="form-control file-input" placeholder="برای آپلود کلیک کنید">
                        <div>
                            <div class="input-group round">
                                <input type="text" name="Picture" asp-for="@Model.Account.PictureName" class="form-control file-input" placeholder="این فیلد کار نمیکنه">
                                <span class="input-group-btn">
                                    <button type="button" class="btn btn-success">
                                        <i class="icon-picture"></i>
                                        آپلود عکس
                                        <div class="paper-ripple"><div class="paper-ripple__background"></div><div class="paper-ripple__waves"></div></div>
                                    </button>
                                </span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <label>نام *</label>
                                <input type="text"name="Name" asp-for="@Model.Account.Name" class="form-control" placeholder="نام" required>
                            </div><!-- End .col-sm-6 -->
                            <div class="col-sm-6">
                                <label>نام خانوادگی *</label>
                                <input type="text"name="Family" asp-for="@Model.Account.Family" class="form-control" placeholder="نام خانوادگی" required>
                            </div><!-- End .col-sm-6 -->
                        </div>
                        <label>ایمیل</label>
                        <input type="email"name="Email" asp-for="@Model.Account.Email" class="form-control" placeholder="آدرس ایمیل" >

                        <label>شماره تلفن*</label>
                        <input type="number"name="PhoneNumber" asp-for="@Model.Account.PhoneNumber" class="form-control" placeholder="شماره تلفن" required>

                        <label>تاریخ تولد</label>
                        <input type="date"name="BirthDate" asp-for="@Model.Account.BirthDate" class="form-control" placeholder="تاریخ تولد">

                        <label>آدرس</label>
                        <input type="text"name="Address" asp-for="@Model.Account.Address" class="form-control" placeholder="آدرس">

                        <div class="form-group mt-3">
                            <button class="btn btn-outline-primary-2 btn-block" type="submit">
                                ویرایش
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div><!-- End .form-box -->
    </div><!-- End .container -->
</div><!-- End .login-page section-bg -->