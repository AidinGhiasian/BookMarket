@page
@using Services.Application
@model BookMarket.Pages.CartModel
@{
    
    var cartTotal = Model.CartItems.Sum(x => x.TotalPrice);

}
<div class="page-header text-center" style="background-image: url('assets/images/page-header-bg.jpg')">
    <div class="container">
        <h1 class="page-title">سبد خرید <span>فروشگاه</span></h1>
    </div><!-- End .container -->
</div><!-- End .page-header -->
<nav aria-label="breadcrumb" class="breadcrumb-nav">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="index-1.html">خانه</a></li>
            <li class="breadcrumb-item"><a href="">فروشگاه</a></li>
            <li class="breadcrumb-item active" aria-current="page">سبد خرید </li>
        </ol>
    </div><!-- End .container -->
</nav><!-- End .breadcrumb-nav -->

<div class="page-content">
    <div class="cart">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <table class="table table-cart table-mobile">
                        <thead>
                            <tr>
                                <th>محصول</th>
                                <th>قیمت</th>
                                <th>تعداد</th>
                                <th>مجموع</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.CartItems)
                            {
                                <tr>
                                    <td class="product-col">
                                        <div class="product">
                                            <figure class="product-media">
                                                <a href="#">
                                                    <img src="/Pictures/@item.PictureFile">
                                                </a>
                                            </figure>

                                            <h3 class="product-title">
                                                <a href="#">@item.BookTitle</a>
                                            </h3><!-- End .product-title -->
                                        </div><!-- End .product -->
                                    </td>
                                    <td class="price-col">@item.Price.ToMoney()</td>
                                    <td class="quantity-col">
                                        <div class="cart-product-quantity">
                                            <div class="input-group input-spinner">
                                                <div class="input-group-prepend">
                                                    <button class="btn btn-spinner btn-decrement" type="button">
                                                        <i class="icon-minus"></i>
                                                    </button>
                                                </div>
                                                <input type="number" class="form-control" value="@item.Count" min="1" max="50" step="1" data-decimals="0" required>
                                                <div class="input-group-append">
                                                    <button class="btn btn-spinner btn-increment" type="button">
                                                        <i class="icon-plus"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div><!-- End .cart-product-quantity -->
                                    </td>
                                    <td class="total-col">@item.TotalPrice.ToMoney()</td>
                                    <td class="remove-col">
                                        <form method="post"
                                              asp-page-handler="RemoveItemFromCart"
                                              asp-route-id="@item.Id"
                                              class="d-inline">

                                            <button type="submit"
                                                    class="btn-remove border-0 bg-transparent p-0"
                                                    title="حذف محصول"
                                                    aria-label="حذف محصول">

                                                <i class="icon-close"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="cart-bottom">
                        <a href="#" class="btn btn-outline-dark-2 ml-auto display-7 px-5">
                            <span>
                                به روز رسانی
                                سبد
                                خرید
                            </span><i class="icon-refresh"></i>
                        </a>
                    </div><!-- End .cart-bottom -->
                </div><!-- End .col-lg-12 -->
                <div class="col-lg-12">
                    <div class="row justify-content-between">
                        <div class="col-lg-6">
                            <h4 class="text-right mb-3">هزینه ارسال</h4>
                            <form action="#">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label for="state">استان : </label>
                                            <div class="select-custom2">
                                                <select name="state" id="state" class="form-control">
                                                    <option value="#" selected="selected">
                                                        استان خود را
                                                        انتخاب کنید
                                                    </option>
                                                    <option value="s">تهران</option>
                                                    <option value="m">تبریز</option>
                                                    <option value="l">مازندران</option>
                                                    <option value="xl">مشهد</option>
                                                </select>
                                            </div><!-- End .select-custom2 -->
                                        </div><!-- End .form-group -->
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label for="city">شهر : </label>
                                            <div class="select-custom2">
                                                <select name="city" id="city" class="form-control">
                                                    <option value="#" selected="selected">
                                                        شهر خود را انتخاب
                                                        کنید
                                                    </option>
                                                    <option value="s">تهران</option>
                                                    <option value="m">کرج</option>
                                                    <option value="l">شهرری</option>
                                                    <option value="xl">اسلامشهر</option>
                                                </select>
                                            </div><!-- End .select-custom2 -->
                                        </div><!-- End .form-group -->
                                    </div>
                                    <div class="col-lg-8">
                                        <div class="form-group">
                                            <label for="address">آدرس</label>
                                            <textarea class="form-control" style="min-height: 20px;"
                                                      placeholder="آدرس کامل خود را بنویسید"></textarea>
                                        </div><!-- End .form-group -->
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="form-group position-custum"
                                             style="position: absolute; bottom: 0;">
                                            <button class="btn btn-outline-primary-2" type="submit">
                                                محاسبه
                                                هزینه
                                                ارسال
                                            </button>
                                        </div><!-- .End .input-group-append -->
                                    </div>
                                </div>
                            </form>
                            <div class="cart-discount">
                                <h4 class="text-right mt-3">کد تخفیف</h4>
                                <form action="#">
                                    <div class="input-group">
                                        <input type="text" class="form-control" required
                                               placeholder="کد تخفیف خود را اینجا وارد کنید">
                                        <div class="input-group-append">
                                            <button class="btn btn-outline-primary-2" type="submit">
                                                <i class="icon-long-arrow-left"></i>
                                            </button>
                                        </div><!-- .End .input-group-append -->
                                    </div><!-- End .input-group -->
                                </form>
                            </div><!-- End .cart-discount -->
                        </div><!-- End .col-lg-6 -->
                        <div class="col-lg-5">
                            <div class="summary summary-cart">
                                <h3 class="summary-title">خلاصه سبد خرید</h3><!-- End .summary-title -->

                                <table class="table table-summary">
                                    <tbody>
                                        <tr class="summary-subtotal">
                                            <td class="border-bottom-0">جمع کل سبد خرید : </td>
                                            <td class="text-left border-bottom-0"> @cartTotal.ToMoney() تومان</td>
                                        </tr><!-- End .summary-subtotal -->

                                        <tr class="summary-subtotal">
                                            <td class="border-bottom-0">هزینه ارسال : </td>
                                            <td class="text-left border-bottom-0">0,000 تومان</td>
                                        </tr><!-- End .summary-subtotal -->

                                        <tr class="summary-subtotal">
                                            <td>تخفیف : </td>
                                            <td class="text-left">0,000 تومان</td>
                                        </tr><!-- End .summary-subtotal -->

                                        <tr class="summary-total">
                                            <td>مبلغ قابل پرداخت :</td>
                                            <td class="text-left">236,000 تومان</td>
                                        </tr><!-- End .summary-total -->
                                    </tbody>
                                </table><!-- End .table table-summary -->
                                <a href="checkout.html"
                                   class="btn btn-outline-primary-2 btn-order float-left btncart2">
                                    <span>
                                        رفتن
                                        به
                                        صفحه
                                        پرداخت
                                    </span><i class="icon-long-arrow-left"></i>
                                </a>
                            </div><!-- End .summary -->
                        </div><!-- End .col-lg-5 -->
                    </div>
                </div>
            </div><!-- End .row -->
        </div><!-- End .container -->
    </div><!-- End .cart -->
</div><!-- End .page-content -->
</main><!-- End .main -->

<style>
    .table-cart .product-col .product {
        height: auto;
        padding: 0;
        border-radius: 0;
        background-color: transparent;
        border: none;
    }
</style>

