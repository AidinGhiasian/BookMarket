@page
@using Services.Application
@model BookMarket.Pages.Blog.IndexModel
@{
}
<div class="page-header text-center" style="background-image: url('assets/images/page-header-bg.jpg')">
    <div class="container">
        <h1 class="page-title">اخبار و مقالات</h1>
    </div><!-- End .container -->
</div><!-- End .page-header -->
<nav aria-label="breadcrumb" class="breadcrumb-nav mb-2">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Index">خانه</a></li>

            @if (Model.BlogsWithCategory == null)
            {
                <li class="breadcrumb-item"><a href="#">اخبار و مقالات</a></li>
            }
            @if (Model.BlogsWithCategory != null)
            {
                <li class="breadcrumb-item "><a href="/Blog/index">کتاب ها</a></li>

                <li class="breadcrumb-item active"><a href="#">@Model.BlogsWithCategory.First().Category<span> @Model.BlogsWithCategory.Count() </span></a></li>
            }
        </ol>
    </div><!-- End .container -->
</nav><!-- End .breadcrumb-nav -->

<div class="page-content">
    <div class="container">
        <nav class="blog-nav">
            <ul class="menu-cat entry-filter justify-content-center">
                <li class="active"><a href="/Blog/Index" data-filter="*">همه<span></span></a></li>

                @if (Model.Categories != null)
                {
                    @foreach (var item in Model.Categories)
                    {
                        <li class="@((Model.BlogsWithCategory != null) ? "active" : "") "><a href="/Blog/Index?id=@item.Id" data-filter="*">
                            @item.Name</a></li>
                    }
                }

            </ul><!-- End .blog-menu -->
        </nav><!-- End .blog-nav -->
        <div class="entry-container max-col-4 row" data-layout="fitRows">
            @if (Model.BlogsWithCategory != null)
            {
                foreach (var item in Model.BlogsWithCategory)
                {

                    <div class="entry-item lifestyle fashion col-sm-6 col-md-4 col-lg-3">
                        <article class="entry entry-grid text-center">
                            <figure class="entry-media">
                                <div>
                                    <a href="/Blog/BlogDetails?Id=@item.Id">
                                        <img src="/Pictures/@item.Picture" alt="توضیحات عکس">
                                    </a>
                                </div><!-- End .owl-carousel -->
                            </figure><!-- End .entry-media -->

                            <div class="entry-body">
                                <div class="entry-meta">
                                    <a href="#">@item.PostTime</a>
                                    <span class="meta-separator">|</span>
                                    <a href="#">3 دیدگاه</a>
                                </div><!-- End .entry-meta -->

                                <h2 class="entry-title text-center">
                                    <a href="/Blog/BlogDetails?Id=@item.Id">@item.Title</a>
                                </h2><!-- End .entry-title -->

                                <div class="entry-cats text-center">
                                    <a href="#">@item.Category</a>
                                </div><!-- End .entry-cats -->

                                <div class="entry-content text-center">
                                    <p>
                                        @item.ShortDescription
                                    </p>
                                    <a href="/Blog/BlogDetails?Id=@item.Id" class="read-more">
                                        ادامه
                                        خواندن
                                    </a>
                                </div><!-- End .entry-content -->
                            </div><!-- End .entry-body -->
                        </article><!-- End .entry -->
                    </div>
                }
            }
            @if (Model.Blogs!=null)
            {
                @foreach (var item in Model.Blogs)
                {
                    <div class="entry-item lifestyle fashion col-sm-6 col-md-4 col-lg-3">
                        <article class="entry entry-grid text-center">
                            <figure class="entry-media">
                                <div>
                                    <a href="/Blog/BlogDetails?Id=@item.Id">
                                        <img src="/Pictures/@item.Picture" alt="توضیحات عکس">
                                    </a>
                                </div><!-- End .owl-carousel -->
                            </figure><!-- End .entry-media -->

                            <div class="entry-body">
                                <div class="entry-meta">
                                    <a href="#">@item.PostTime</a>
                                    <span class="meta-separator">|</span>
                                    <a href="#">3 دیدگاه</a>
                                </div><!-- End .entry-meta -->

                                <h2 class="entry-title text-center">
                                    <a href="/Blog/BlogDetails?Id=@item.Id">@item.Title</a>
                                </h2><!-- End .entry-title -->

                                <div class="entry-cats text-center">
                                    <a href="#">@item.Category</a>
                                </div><!-- End .entry-cats -->

                                <div class="entry-content text-center">
                                    <p>
                                        @item.ShortDescription
                                    </p>
                                    <a href="/Blog/BlogDetails?Id=@item.Id" class="read-more">
                                        ادامه
                                        خواندن
                                    </a>
                                </div><!-- End .entry-content -->
                            </div><!-- End .entry-body -->
                        </article><!-- End .entry -->
                    </div>

                }
            }
        </div>

        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item disabled">
                    <a class="page-link page-link-prev" href="#" aria-label="Previous" tabindex="-1"
                       aria-disabled="true">
                        <span aria-hidden="true"><i class="icon-long-arrow-right"></i></span>قبلی
                    </a>
                </li>
                <li class="page-item active" aria-current="page"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item">
                    <a class="page-link page-link-next" href="#" aria-label="Next">
                        بعدی<span aria-hidden="true"><i class="icon-long-arrow-left"></i></span>
                    </a>
                </li>
            </ul>
        </nav>
    </div><!-- End .container -->
</div><!-- End .page-content -->